# AI Configuration
# ========================================
# مساعد الذكاء الاصطناعي يعمل بـ Google Gemini عبر Supabase Edge Function (ai-chat) فقط.
# مفتاح Gemini لا يوضع هنا ولا في أي ملف في التطبيق — مكانه Supabase Secrets فقط:
#   npx supabase secrets set GEMINI_API_KEY=<المفتاح> --project-ref <project-ref>
# التطبيق يحتاج فقط عنوان الدالة:
# ========================================

EXPO_PUBLIC_AI_API_ENDPOINT=https://krtulodnhmfuoxjqajwl.supabase.co/functions/v1/ai-chat
# EXPO_PUBLIC_AI_API_KEY removed: AI keys must live only in Supabase Edge Function secrets (GEMINI_API_KEY)

# AdMob Rewarded ad unit IDs (production only; dev builds use Google test ads)
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=ca-app-pub-7553202956815424/1403641578
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
# true = always use Google test ads (local/dev/preview). Production builds use false (eas.json).
EXPO_PUBLIC_ADMOB_USE_TEST_ADS=true
