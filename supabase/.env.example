# Supabase Edge Functions - Environment Variables
# للتطوير المحلي فقط (local development)
#
# انسخ هذا الملف إلى: supabase/.env.local
# واستبدل القيم بالحقيقية (لا ترفع supabase/.env.local على Git)

# Google Gemini API Key (دالة ai-chat)
GEMINI_API_KEY=your-gemini-api-key

# اختياري: تغيير النماذج بدون تعديل الكود
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# ملاحظات:
# 1. للـ production استخدم: npx supabase secrets set GEMINI_API_KEY=...
# 2. احصل على المفتاح من: https://aistudio.google.com/apikey
