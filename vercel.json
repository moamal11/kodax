{
  "framework": null,
  "buildCommand": "node scripts/prepare-build-env.js && npx expo export --platform web && node scripts/copy-web-fonts.js && npx tsx scripts/build-web-public.ts",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": { "api/public-page.js": { "includeFiles": "web-server/**", "maxDuration": 30 } },
  "rewrites": [
    { "source": "/code/add", "destination": "/code-create" },
    { "source": "/discussion/new", "destination": "/discussion-create" },
    { "source": "/sitemap.xml", "destination": "/api/public-page?kind=sitemap&key=index" },
    { "source": "/sitemap-:kind(user|code|discussion)-:page(\\d+).xml", "destination": "/api/public-page?kind=sitemap&key=:kind-:page" },
    { "source": "/user/:id", "destination": "/api/public-page?kind=user&key=:id" },
    { "source": "/code/:id", "destination": "/api/public-page?kind=code&key=:id" },
    { "source": "/discussion/:id", "destination": "/api/public-page?kind=discussion&key=:id" },
    { "source": "/field/:id", "destination": "/api/public-page?kind=field&key=:id" },
    { "source": "/course/:id", "destination": "/api/public-page?kind=course&key=:id" },
    { "source": "/lesson/:id", "destination": "/api/public-page?kind=lesson&key=:id" },
    { "source": "/challenge/:id", "destination": "/api/public-page?kind=challenge&key=:id" }
  ],

  "redirects": [
    { "source": "/sitemap-0.xml", "destination": "/sitemap.xml", "permanent": true },
    {
      "source": "/account-deletion",
      "destination": "/delete-account/",
      "permanent": true
    }
  ],
  "headers": [
    { "source": "/kodax-push-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/api/public-page", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/_expo/static/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "font/ttf"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
