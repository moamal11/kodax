{
  "expo": {
    "name": "Kodax",
    "slug": "kodax",
    "owner": "mo_nz",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "kodax",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kodax.app"
    },
    "android": {
      "package": "com.kodax.app",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/kodax-light-trans.png",
        "backgroundColor": "#0a0a0f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static",
      "description": "Kodax AI App",
      "config": {
        "pwa": {
          "name": "Kodax",
          "shortName": "Kodax",
          "themeColor": "#0a0a0f",
          "backgroundColor": "#0a0a0f",
          "display": "standalone",
          "orientation": "portrait",
          "icon": "./assets/splash.png"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-font",
      "expo-updates",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7553202956815424~1089790112",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "نستخدم هذا فقط لعرض إعلانات مكافأة اختيارية أكثر ملاءمة لك."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نستخدم معرض الصور فقط عندما تختار صورة لملفك الشخصي.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8b5cf6",
          "defaultChannel": "default"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0f11f7e3-6a89-4669-9d31-96cc6881129e"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f11f7e3-6a89-4669-9d31-96cc6881129e"
      }
    }
  }
}
